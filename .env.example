# ══════════════════════════════════════════════════════════════
# DLC-KAZE — Variables d'environnement
# ══════════════════════════════════════════════════════════════
# Copier ce fichier :  cp .env.example .env
# Puis remplir les valeurs avec vos identifiants réels.
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────
# Serveur
# ──────────────────────────────────────
NODE_ENV=development
PORT=4000

# ──────────────────────────────────────
# Base de données PostgreSQL
# ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dlc_kaze

# ──────────────────────────────────────
# JWT (authentification)
# ──────────────────────────────────────
JWT_SECRET=changez-moi-en-production-avec-un-secret-fort
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────
# Client (URL front pour CORS + liens dans les emails)
# ──────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ──────────────────────────────────────
# API Kaze (https://app.kaze.so)
# Authentification par login/mot de passe → JWT automatique
# ──────────────────────────────────────
KAZE_API_BASE_URL=https://app.kaze.so/api
KAZE_LOGIN=votre-email-kaze@exemple.com
KAZE_PASSWORD=votre-mot-de-passe-kaze

# ──────────────────────────────────────
# Webhook Kaze (secret HMAC SHA-256 pour vérifier les signatures)
# Configurez ce même secret dans Kaze > Paramètres > Webhooks
# ──────────────────────────────────────
KAZE_WEBHOOK_SECRET=votre-secret-webhook-kaze
# Target Kaze (société/entité exécutante) requis pour éviter les jobs en statut "initial"
KAZE_TARGET_ID=ffbb89b8-b714-4fe3-9d7b-42dfafdbe6ba

# ──────────────────────────────────────
# API Partenaire Interenchères (Bearer token)
# ──────────────────────────────────────
INTERENCHERES_API_KEY=cle-prod-interencheres
# Optionnel: clé de test/sandbox
INTERENCHERES_API_KEY_SANDBOX=cle-sandbox-interencheres

# ──────────────────────────────────────
# Email — Resend (recommandé)
# ──────────────────────────────────────
# Clé API créée sur https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#
# Expéditeur. Tant que le domaine n'est pas vérifié dans Resend,
# utiliser onboarding@resend.dev (n'envoie qu'à votre propre adresse).
# Une fois dlc-kaze.fr vérifié : DLC Kaze <noreply@dlc-kaze.fr>
# EMAIL_FROM=DLC Kaze <onboarding@resend.dev>

# ──────────────────────────────────────
# Email SMTP (repli si RESEND_API_KEY absent)
# Sans aucune config, les emails sont loggés en console.
# ──────────────────────────────────────
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_USER=votre-utilisateur-smtp
# SMTP_PASS=votre-mot-de-passe-smtp
# SMTP_FROM=DLC Kaze <noreply@dlc-kaze.fr>

# ──────────────────────────────────────
# Telegram — annonce des missions disponibles
# ──────────────────────────────────────
# Canal privilégié pour la diffusion : une mission publiée = un seul
# message dans le salon commun, quel que soit le nombre de convoyeurs.
# WhatsApp facturant chaque destinataire, il ne sert que de repli si
# ces deux variables sont absentes.
#
# Mise en place :
#   1. Créer le bot via @BotFather sur Telegram → jeton
#   2. Créer le groupe « Missions DLC », y ajouter le bot
#   3. Poster un message dans le groupe, puis relever l'identifiant sur
#      https://api.telegram.org/bot<JETON>/getUpdates
#
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Identifiant du salon — négatif pour un groupe
# TELEGRAM_CHAT_ID=-1001234567890

# ──────────────────────────────────────
# WhatsApp Business — notification des convoyeurs
# ──────────────────────────────────────
# Meta Cloud API : https://developers.facebook.com/apps
# Sans ces variables, les notifications sont loggées en console.
#
# Jeton permanent (System User) de l'application Meta
# WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxx
#
# Identifiant du numéro expéditeur (Phone Number ID, pas le numéro lui-même)
# WHATSAPP_PHONE_ID=123456789012345
#
# Nom du template validé par Meta et sa langue
# WHATSAPP_TEMPLATE=mission_disponible
# WHATSAPP_TEMPLATE_LANG=fr

# ──────────────────────────────────────
# Admin (email pour les notifications d'inscription)
# ──────────────────────────────────────
ADMIN_EMAIL=admin@dlc-kaze.fr
