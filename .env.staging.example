# ═══════════════════════════════════════════════════════════════
# STAGING — environnement de test (staging.<votre-domaine>)
#
# Copier ce fichier en `.env` dans ~/dlc-kaze-staging sur o2switch,
# puis remplir les valeurs marquées À_REMPLIR.
#
# La base de staging ne contient QUE des comptes de test (jamais de
# copie de la prod). Les e-mails partent donc réellement, vers les
# adresses de ces comptes de test. Telegram publie dans un groupe
# dédié au staging. Kaze et WhatsApp restent coupés.
# ═══════════════════════════════════════════════════════════════

# `production` : le front buildé est servi et les missions démo sont
# masquées, comme en vrai. Le staging doit se comporter comme la prod.
NODE_ENV=production
# Port différent de la prod si les deux tournent côte à côte.
# (Avec Passenger / « Setup Node.js App », le port est ignoré.)
PORT=5001

# ── Base de données : base DÉDIÉE au staging ───────────────────
# Utilisateur et base distincts de la prod (créés dans cPanel).
# Ne JAMAIS mettre ici l'URL de la base de production, et ne jamais
# y charger une sauvegarde de prod : uniquement des comptes de test.
DATABASE_URL=postgresql://ficl7064_staging:À_REMPLIR@localhost:5432/ficl7064_dlc_staging

# ── Authentification ───────────────────────────────────────────
# Secret DIFFÉRENT de la prod : un jeton de staging ne doit pas
# ouvrir une session en production. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=À_REMPLIR
JWT_EXPIRES_IN=7d

# URL publique du staging (liens dans les e-mails, CORS).
CLIENT_URL=https://staging.À_REMPLIR
# Cookie de session distinct de la prod (évite la collision dlc_token → 401)
AUTH_COOKIE_NAME=dlc_token_staging
COOKIE_DOMAIN=

# ── Kaze : COUPÉ ───────────────────────────────────────────────
# Bloque tout appel à Kaze, même si des identifiants traînent.
# Les missions de test restent dans la base staging uniquement.
KAZE_DISABLED=true
KAZE_LOGIN=
KAZE_PASSWORD=
KAZE_API_KEY=
KAZE_API_TOKEN=
KAZE_TARGET_ID=
KAZE_WEBHOOK_SECRET=
# Pas de synchronisation Kaze en staging.
SYNC_INTERVAL_MS=0

# ── E-mails : ACTIFS ───────────────────────────────────────────
# Même fournisseur que la prod (Resend). Les envois partent vers les
# adresses des comptes de test : utilisez des adresses que vous lisez
# (ex. vous+client1@gmail.com, vous+convoyeur1@gmail.com).
RESEND_API_KEY=À_REMPLIR
# Préfixe « [STAGING] » dans le nom pour reconnaître les e-mails de test.
EMAIL_FROM="[STAGING] Drive Line Connect <À_REMPLIR>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Adresse qui reçoit les alertes admin du staging.
ADMIN_EMAIL=À_REMPLIR

# ── Telegram : groupe DÉDIÉ au staging ─────────────────────────
# Jamais le groupe des vrais convoyeurs. Créer un groupe « DLC Staging »,
# y ajouter le bot, puis récupérer l'identifiant du groupe avec
# scripts/telegram-chat-id.js (commence par -100…).
TELEGRAM_BOT_TOKEN=À_REMPLIR
# Groupe « Mission dlc Staging » : annonces de missions…
TELEGRAM_CHAT_ID=-5431004242
# …et alertes de supervision (salon séparé en prod, même groupe ici).
TELEGRAM_ALERTES_CHAT_ID=-5431004242

# ── WhatsApp : COUPÉ ───────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# ── Partenaire Interenchères ───────────────────────────────────
# Clé SANDBOX à transmettre à Interenchères pour leurs tests sur
# https://staging.drivelineconnect.com/api/v1/… (en-tête
# « Authorization: Bearer <clé> »). Jamais la clé de prod.
# Générer avec : openssl rand -hex 32
INTERENCHERES_API_KEY=
INTERENCHERES_API_KEY_SANDBOX=À_REMPLIR
