# ══════════════════════════════════════════════════════════════
# DLC-KAZE — Variables d'environnement PRODUCTION
# ══════════════════════════════════════════════════════════════
# Copier ce fichier en `.env` à la racine du projet sur le serveur,
# puis remplir chaque valeur. Ne jamais versionner le .env rempli.
# ══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4000

# ──────────────────────────────────────────────────────
# Base de données PostgreSQL
# ──────────────────────────────────────────────────────
# o2switch : créer la base via cPanel > PostgreSQL, l'hôte est localhost.
# Base externe (Neon, Supabase…) : coller l'URL fournie, qui contient
# déjà l'hôte distant. Ajouter ?sslmode=require si le fournisseur l'exige.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/BASE

# ──────────────────────────────────────────────────────
# JWT — secret de signature des sessions
# ──────────────────────────────────────────────────────
# ⚠️ Générer une valeur unique, jamais celle du développement :
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=A_GENERER_64_OCTETS_ALEATOIRES
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────────────
# URL publique — utilisée par CORS et les liens des emails
# ──────────────────────────────────────────────────────
CLIENT_URL=https://votre-domaine.fr

# ──────────────────────────────────────────────────────
# API Kaze
# ──────────────────────────────────────────────────────
KAZE_API_BASE_URL=https://app.kaze.so/api
KAZE_LOGIN=
KAZE_PASSWORD=
KAZE_API_TOKEN=
KAZE_TARGET_ID=ffbb89b8-b714-4fe3-9d7b-42dfafdbe6ba
# Secret partagé vérifiant la signature des webhooks entrants.
KAZE_WEBHOOK_SECRET=

# Intervalle du polling interne Kaze → DLC, en millisecondes.
# Mettre 0 en hébergement mutualisé : Passenger endort l'application entre
# deux visites, le polling interne y est donc peu fiable. La synchronisation
# est alors assurée par le cron, avec scripts/sync-once.js.
SYNC_INTERVAL_MS=0

# ──────────────────────────────────────────────────────
# Emails clients — Resend (prioritaire)
# ──────────────────────────────────────────────────────
# Le domaine doit être vérifié dans Resend (SPF/DKIM) pour écrire
# à des tiers. Sans clé, l'application bascule sur le SMTP ci-dessous.
RESEND_API_KEY=
EMAIL_FROM=DLC Kaze <noreply@votre-domaine.fr>

# ──────────────────────────────────────────────────────
# Emails — SMTP de secours
# ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DLC Kaze <noreply@votre-domaine.fr>

# Destinataire des notifications d'inscription.
ADMIN_EMAIL=admin@votre-domaine.fr

# ──────────────────────────────────────────────────────
# Notifications convoyeurs — WhatsApp Cloud API (Meta)
# ──────────────────────────────────────────────────────
# Sans ces valeurs, les notifications sont seulement journalisées.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=mission_disponible

# ──────────────────────────────────────────────────────
# API partenaire Interenchères
# ──────────────────────────────────────────────────────
# Sans clé, l'API partenaire démarre NON sécurisée : la renseigner
# si l'intégration est exposée publiquement.
INTERENCHERES_API_KEY=
