{
  "name": "dlc-kaze",
  "version": "1.0.0",
  "description": "Plateforme SaaS de convoyage automobile avec intégration API Kaze",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "start:prod": "NODE_ENV=production npm run start --workspace=server",
    "deploy": "npm run build && echo '✅ Build prêt pour déploiement'",
    "check:prod": "node scripts/check-prod.js",
    "sync:once": "node scripts/sync-once.js",
    "db:migrate": "npm run migrate --workspace=server",
    "db:migrate:lot": "npm run migrate:lot --workspace=server",
    "db:migrate:vitrine": "npm run migrate:vitrine --workspace=server",
    "db:migrate:factures": "npm run migrate:factures --workspace=server",
    "db:migrate:docs-rc": "npm run migrate:docs-rc --workspace=server",
    "db:migrate:demande-docs": "npm run migrate:demande-docs --workspace=server",
    "db:migrate:missions-internes": "npm run migrate:missions-internes --workspace=server",
    "db:seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test:coverage": "npm run test:coverage --workspace=server && npm run test:coverage --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
