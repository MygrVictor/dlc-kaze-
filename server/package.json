{
  "name": "server",
  "version": "1.0.0",
  "description": "Drive Line Connect — API Backend",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:documents": "node src/db/migrate-documents.js",
    "migrate:lot": "node src/db/migrate-lot.js",
    "migrate:demande-poste": "node src/db/migrate-demande-poste.js",
    "migrate:convoyeur-qualif": "node src/db/migrate-convoyeur-qualification.js",
    "migrate:factures": "node src/db/migrate-factures.js",
    "migrate:docs-rc": "node src/db/migrate-docs-rc.js",
    "migrate:vitrine": "npm run migrate:demande-poste && npm run migrate:convoyeur-qualif",
    "seed": "node src/db/seed.js",
    "test": "cross-env NODE_ENV=test jest --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --forceExit"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.3.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.12.0",
    "resend": "^6.19.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
