node_modules/
dist/
build/
coverage/

# Exception : le build du front est versionné.
#
# Le serveur Express sert `client/dist` en statique, mais l'hébergement
# mutualisé n'installe que les dépendances de production : Vite y est
# absent, et l'y installer tirerait toute la chaîne de test pour rien.
# Le build est donc fabriqué en local puis poussé tel quel, le
# déploiement se réduisant à un `git pull`.
!client/dist/
!client/dist/**

# Variables d'environnement — jamais versionnées
.env
.env.*
!.env.example
!.env.production.example

# Dumps de diagnostic Kaze : contiennent des données client réelles
# (noms, adresses, immatriculations) et l'email du compte Kaze.
*-dump.json
.tmp_pdfenv

# Fichiers téléversés par les utilisateurs (pièces d'identité, permis…)
uploads/

*.log
.DS_Store


# Archives de déploiement (générées localement)
*.zip
